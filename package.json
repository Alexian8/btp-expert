{
  "name": "btp-expert-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @btp/desktop",
    "dev:server": "npm run dev -w @btp/server",
    "build": "npm run build -w @btp/desktop",
    "dist": "npm run dist -w @btp/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
