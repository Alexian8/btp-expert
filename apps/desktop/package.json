{
  "name": "@btp/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "description": "BatiDesk — Application de gestion pour artisans du bâtiment",
  "author": "JACOB HABITAT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:mac:arm": "npm run build && electron-builder --mac --arm64 --publish=never",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64 --publish=never",
    "release:win": "npm run build && electron-builder --win --publish=never -c.win.signingHashAlgorithms=sha256",
    "release:win:signed": "npm run build && electron-builder --win --publish=never",
    "release:mac": "npm run build && electron-builder --mac --publish=never",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'postinstall rebuild skipped'",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 308",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/msal-node": "^2.15.0",
    "@btp/core": "*",
    "@btp/types": "*",
    "@btp/ui": "*",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/electron": "^7.13.0",
    "@tanstack/react-query": "^5.59.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dictionary-fr": "^3.0.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.454.0",
    "nspell": "^2.1.5",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^23.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.batidesk.app",
    "productName": "BatiDesk",
    "copyright": "Copyright © 2026 JACOB HABITAT",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build-resources"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "puppeteer.config.cjs",
      "!**/*.map",
      "!**/.cache/puppeteer/**",
      "!**/puppeteer-cache/**",
      "!**/.local-chromium/**"
    ],
    "compression": "maximum",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "JACOB HABITAT",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BatiDesk",
      "menuCategory": "JACOB HABITAT",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico"
    },
    "mac": {
      "icon": "build-resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSApplicationCategoryType": "public.app-category.business"
      }
    },
    "dmg": {
      "title": "BatiDesk ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  }
}
