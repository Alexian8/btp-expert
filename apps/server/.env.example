# ═══════════════════════════════════════════════════════════════════════════
# BatiDesk Server — variables d'environnement
# Copier en .env (NE JAMAIS committer)
# ═══════════════════════════════════════════════════════════════════════════

# Port d'écoute (en local). Sur cPanel/Passenger, c'est le hosting qui décide.
PORT=3001

# Origines CORS autorisées (séparateur virgule)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://intranet.jacobhabitat-dev.fr

# JWT — TOUJOURS générer un secret aléatoire en prod :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-please-use-64-bytes-of-randomness
JWT_EXPIRES_IN=7d

# ─── MySQL (cPanel o2switch) ─────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mime9297_btpadmin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=mime9297_btp
MYSQL_CONNECTION_LIMIT=10

# Rétention backups quotidiens (cron)
BACKUP_RETENTION_COUNT=14

# Environnement
NODE_ENV=production

# ─── Sentry (monitoring d'erreurs, optionnel) ────────────────────────────
# Laisser vide pour désactiver. Pour activer :
#   1. Créer un projet "Node.js / Express" sur https://sentry.io
#   2. Coller la DSN ci-dessous
SENTRY_DSN=
# 0 = errors only (recommandé : gratuit jusqu'à 5k events/mois)
SENTRY_TRACES_SAMPLE_RATE=0
