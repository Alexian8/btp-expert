# ═══════════════════════════════════════════════════════════════════════════
# BatiDesk Server — variables d'environnement
# Copier en .env (NE JAMAIS committer)
# ═══════════════════════════════════════════════════════════════════════════

# Port d'écoute (en local). Sur cPanel/Passenger, c'est le hosting qui décide.
PORT=3001

# Origines CORS autorisées (séparateur virgule)
# En prod : domaines de l'intranet + URL desktop si auto-update
CORS_ORIGINS=http://localhost:5173,https://intranet.jacobhabitat-dev.fr

# JWT — TOUJOURS générer un secret aléatoire en prod :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-please-use-64-bytes-of-randomness
JWT_EXPIRES_IN=7d

# ─── MySQL (cPanel o2switch) ─────────────────────────────────────────────
# Sur cPanel, le user et la base sont préfixés par votre login,
# ex: "loris_btp" et "loris_btpadmin".
# MYSQL_HOST = "localhost" si Node tourne sur le même hosting que MySQL.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=loris_btpadmin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=loris_btp
MYSQL_CONNECTION_LIMIT=10

# Environnement
NODE_ENV=production
