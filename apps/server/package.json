{
  "name": "@btp/server",
  "version": "0.1.0",
  "private": true,
  "description": "BatiDesk — backend HTTP (Express). Implémente le contrat REST consommé par ApiDataService.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "passenger:start": "node app.js",
    "migrate:sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "sync:desktop": "tsx scripts/sync-from-desktop.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@btp/core": "*",
    "@btp/types": "*",
    "@sentry/node": "^10.52.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0"
  }
}
